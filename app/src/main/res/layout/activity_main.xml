<?xml version="1.0" encoding="utf-8"?>
<!-- Home: one huge on/off ear, volume pictures, place pictures. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top: earphone status pill + voice help -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp">

        <LinearLayout
            android:id="@+id/earphone_pill"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/a11y_earphone"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_earbud"
                android:tint="@color/ink" />

            <FrameLayout
                android:id="@+id/earphone_status_bg"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="8dp">
                <ImageView
                    android:id="@+id/earphone_status_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check"
                    android:tint="@color/white" />
            </FrameLayout>

            <ImageView
                android:id="@+id/earphone_speed"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_bolt" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Shown when battery saver is on -->
        <ImageView
            android:id="@+id/saver_badge"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/saver_badge"
            android:padding="9dp"
            android:src="@drawable/ic_battery"
            android:tint="@color/amber"
            android:visibility="gone" />

        <include layout="@layout/voice_button" />
    </LinearLayout>

    <!-- Centre: the big ear button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/big_button"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/big_icon"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/meter"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:importantForAccessibility="no"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/state_word"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="28sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Volume: quieter / bars / louder -->
    <LinearLayout
        style="@style/Sunai.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/vol_down"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/a11y_vol_down">
            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_vol_down"
                android:tint="@color/blue" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/vol_bars"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:gravity="bottom"
            android:orientation="horizontal" />

        <FrameLayout
            android:id="@+id/vol_up"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/a11y_vol_up">
            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_vol_up"
                android:tint="@color/white" />
        </FrameLayout>
    </LinearLayout>

    <!-- Place: home / talk / crowd -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginStart="13dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="13dp"
        android:layout_marginBottom="14dp"
        android:orientation="horizontal">

        <LinearLayout android:id="@+id/place_home" style="@style/Sunai.Tile"
            android:layout_height="match_parent" android:contentDescription="@string/place_home">
            <ImageView android:layout_width="40dp" android:layout_height="40dp"
                android:importantForAccessibility="no" android:src="@drawable/ic_place_home" />
            <TextView style="@style/Sunai.Word" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/place_home" />
        </LinearLayout>

        <LinearLayout android:id="@+id/place_talk" style="@style/Sunai.Tile"
            android:layout_height="match_parent" android:contentDescription="@string/place_talk">
            <ImageView android:layout_width="40dp" android:layout_height="40dp"
                android:importantForAccessibility="no" android:src="@drawable/ic_place_talk" />
            <TextView style="@style/Sunai.Word" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/place_talk" />
        </LinearLayout>

        <LinearLayout android:id="@+id/place_crowd" style="@style/Sunai.Tile"
            android:layout_height="match_parent" android:contentDescription="@string/place_crowd">
            <ImageView android:layout_width="40dp" android:layout_height="40dp"
                android:importantForAccessibility="no" android:src="@drawable/ic_place_crowd" />
            <TextView style="@style/Sunai.Word" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/place_crowd" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/nav_bar" />
</LinearLayout>
