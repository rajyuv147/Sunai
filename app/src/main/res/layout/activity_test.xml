<?xml version="1.0" encoding="utf-8"?>
<!-- Ear test: pick an ear, play a tone, answer with thumbs up (green) or down (red). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp">
        <FrameLayout android:id="@+id/back" style="@style/Sunai.Back">
            <ImageView android:layout_width="32dp" android:layout_height="32dp"
                android:layout_gravity="center" android:importantForAccessibility="no"
                android:src="@drawable/ic_back" android:tint="@color/ink" />
        </FrameLayout>
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <include layout="@layout/voice_button" />
    </LinearLayout>

    <!-- Which ear -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginStart="13dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="13dp"
        android:orientation="horizontal">
        <LinearLayout android:id="@+id/ear_left" style="@style/Sunai.Tile"
            android:layout_height="match_parent" android:contentDescription="@string/ear_left">
            <ImageView android:layout_width="64dp" android:layout_height="64dp"
                android:importantForAccessibility="no" android:scaleX="-1"
                android:src="@drawable/ic_ear" />
            <TextView style="@style/Sunai.Word" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/ear_left" />
        </LinearLayout>
        <LinearLayout android:id="@+id/ear_right" style="@style/Sunai.Tile"
            android:layout_height="match_parent" android:contentDescription="@string/ear_right">
            <ImageView android:layout_width="64dp" android:layout_height="64dp"
                android:importantForAccessibility="no" android:src="@drawable/ic_ear" />
            <TextView style="@style/Sunai.Word" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/ear_right" />
        </LinearLayout>
    </LinearLayout>

    <!-- Testing -->
    <LinearLayout
        android:id="@+id/test_group"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="20dp">

        <LinearLayout android:id="@+id/test_dots" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="center"
            android:orientation="horizontal" />

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1">
            <FrameLayout android:id="@+id/play_btn" android:layout_width="200dp"
                android:layout_height="200dp" android:layout_gravity="center"
                android:clickable="true" android:focusable="true"
                android:contentDescription="@string/a11y_play_tone">
                <ImageView android:id="@+id/play_icon" android:layout_width="96dp"
                    android:layout_height="96dp" android:layout_gravity="center"
                    android:importantForAccessibility="no" android:src="@drawable/ic_voice" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="120dp"
            android:orientation="horizontal">
            <LinearLayout android:id="@+id/no_btn" style="@style/Sunai.Tile"
                android:layout_height="match_parent" android:layout_marginStart="0dp"
                android:layout_marginEnd="7dp" android:contentDescription="@string/not_heard">
                <ImageView android:layout_width="56dp" android:layout_height="56dp"
                    android:importantForAccessibility="no" android:rotation="180"
                    android:src="@drawable/ic_thumb_up" android:tint="@color/white" />
                <TextView style="@style/Sunai.Word" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/not_heard"
                    android:textColor="@color/white" android:textSize="18sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/yes_btn" style="@style/Sunai.Tile"
                android:layout_height="match_parent" android:layout_marginStart="7dp"
                android:layout_marginEnd="0dp" android:contentDescription="@string/heard">
                <ImageView android:layout_width="56dp" android:layout_height="56dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_thumb_up" android:tint="@color/white" />
                <TextView style="@style/Sunai.Word" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/heard"
                    android:textColor="@color/white" android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Done -->
    <LinearLayout
        android:id="@+id/done_group"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="20dp"
        android:visibility="gone">
        <FrameLayout android:id="@+id/done_badge" android:layout_width="190dp"
            android:layout_height="190dp">
            <ImageView android:layout_width="96dp" android:layout_height="96dp"
                android:layout_gravity="center" android:importantForAccessibility="no"
                android:src="@drawable/ic_check" android:tint="@color/white" />
        </FrameLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="@string/test_done"
            android:textSize="28sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="96dp"
            android:layout_marginTop="18dp" android:orientation="horizontal">
            <LinearLayout android:id="@+id/again_btn" style="@style/Sunai.Tile"
                android:layout_height="match_parent" android:layout_marginStart="0dp"
                android:layout_marginEnd="7dp" android:contentDescription="@string/again">
                <ImageView android:layout_width="40dp" android:layout_height="40dp"
                    android:importantForAccessibility="no" android:src="@drawable/ic_retry"
                    android:tint="@color/ink" />
                <TextView style="@style/Sunai.Word" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/again" />
            </LinearLayout>
            <LinearLayout android:id="@+id/forward_btn" style="@style/Sunai.Tile"
                android:layout_height="match_parent" android:layout_marginStart="7dp"
                android:layout_marginEnd="0dp" android:contentDescription="@string/forward">
                <ImageView android:layout_width="40dp" android:layout_height="40dp"
                    android:importantForAccessibility="no" android:src="@drawable/ic_arrow"
                    android:tint="@color/white" />
                <TextView style="@style/Sunai.Word" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/forward"
                    android:textColor="@color/white" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
